\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces EventGS benchmark results across three scenes and four configurations. \textbf  {Sign} = fraction of Gaussians whose recovered motion has the correct sign (chance $=0.5$). \textbf  {KF} = number of keyframes requested. The bar scene isolates the aperture problem: event-only recovery is at chance (sign $0.53$); keyframe and CMax both break it, and the full model recovers correct-sign motion while requesting $\sim $$100\times $ fewer keyframes than fixed cadence (B).}}{7}{table.caption.1}\protected@file@percent }
\newlabel{tab:results}{{1}{7}{EventGS benchmark results across three scenes and four configurations. \textbf {Sign} = fraction of Gaussians whose recovered motion has the correct sign (chance $=0.5$). \textbf {KF} = number of keyframes requested. The bar scene isolates the aperture problem: event-only recovery is at chance (sign $0.53$); keyframe and CMax both break it, and the full model recovers correct-sign motion while requesting $\sim $$100\times $ fewer keyframes than fixed cadence (B)}{table.caption.1}{}}
\newlabel{tab:results@cref}{{[table][1][]1}{[1][6][]7}}
\@LN@col{1}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Real-video event+frame reconstruction (jellyfish, 8 frames). EventGS improves PSNR over the static baseline on every frame by leveraging the event stream to update the baseline 3DGS scene.}}{7}{table.caption.2}\protected@file@percent }
\newlabel{tab:realvideo}{{2}{7}{Real-video event+frame reconstruction (jellyfish, 8 frames). EventGS improves PSNR over the static baseline on every frame by leveraging the event stream to update the baseline 3DGS scene}{table.caption.2}{}}
